FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends git libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /service
COPY requirements.txt ./
# Torch CPU: a GT 610 não é suportada por CUDA atual. SAM 2 e DINOv2 rodam
# corretamente em CPU para o benchmark, ainda que mais devagar.
RUN python -m pip install --no-cache-dir torch==2.10.0 torchvision --index-url https://download.pytorch.org/whl/cpu \
    && python -m pip install --no-cache-dir -r requirements.txt
COPY app ./app
COPY scripts ./scripts
CMD ["python", "-m", "app.services.vision_worker"]
