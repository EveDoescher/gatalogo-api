GEMINI_API_KEY=sua_chave_aqui
GEMINI_MODEL=gemini-3.5-flash-lite
MAX_IMAGE_MB=10
MODEL_CACHE_DIR=.model-cache
DETECTOR_CONFIDENCE=0.6
DETECTOR_FALLBACK_CONFIDENCE=0.40
SECONDARY_CAT_MAX_AREA_RATIO=0.35
GEMINI_MAX_RETRIES=1
GEMINI_MAX_OUTPUT_TOKENS=1024
VISION_MAX_SIDE=960
GEMINI_MAX_SIDE=640
ANALYSIS_CACHE_DIR=.analysis-cache
LOCAL_SEMANTIC_GATE_ENABLED=true
LOCAL_SOLID_DOMINANCE_THRESHOLD=0.96
LOCAL_SOLID_MIN_DETECTOR_CONFIDENCE=0.85
SAM2_CHECKPOINT=.model-cache/sam2.1_hiera_tiny.pt
SAM2_CONFIG=configs/sam2.1/sam2.1_hiera_t.yaml
VISION_DEVICE=cpu
COLOR_CLUSTER_COUNT=4
COLOR_MIN_COVERAGE=0.03
COLOR_MERGE_DISTANCE=18
COLOR_SHADE_CHROMA_DISTANCE=14
COLOR_BLACK_L_THRESHOLD=45

# Autenticação e sincronização. Nunca reutilize estes valores de exemplo.
DATABASE_URL=postgresql+asyncpg://gatalogo:gatalogo@localhost:5432/gatalogo
POSTGRES_DB=gatalogo
POSTGRES_USER=gatalogo
POSTGRES_PASSWORD=troque_por_uma_senha_local_forte
POSTGRES_PORT=5432
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio
JWT_ISSUER=gatalogo-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_PEPPER=troque_por_um_segredo_longo_e_aleatorio
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@gatalogo.local
SMTP_USE_TLS=false
# Mailpit local: docker compose up -d mailpit e http://localhost:8025
SMTP_ENABLED=true
GOOGLE_WEB_CLIENT_ID=
# Caminho absoluto do JSON da conta de serviço Firebase, somente no servidor.
FCM_SERVICE_ACCOUNT_FILE=
# Opcional: usado apenas se não estiver presente no JSON da conta de serviço.
FCM_PROJECT_ID=
PHOTO_STORAGE_DIR=storage
TOMBSTONE_RETENTION_DAYS=90

# Reconhecimento SAM 2 + DINOv2 (worker CPU; lento por natureza)
VISION_WORKER_POLL_SECONDS=2
VISION_JOB_MAX_ATTEMPTS=3
DINOV2_MODEL_NAME=dinov2_vits14
MATCH_SIMILARITY_THRESHOLD=0.78
SOLID_COAT_SIMILARITY_THRESHOLD=0.88
MATCH_MAX_DISTANCE_METERS=50000
MATCH_MIN_QUALITY=0.35
# Avaliar sugestões sem gerar notificações automáticas de correspondência.
MATCH_SHADOW_MODE=true
MATCH_FINE_PAIR_LIMIT=6
VISION_JOB_LEASE_SECONDS=1800
