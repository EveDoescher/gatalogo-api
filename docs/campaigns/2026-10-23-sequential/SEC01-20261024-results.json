      "change": "Fixed key endpoint, RS256 verification, exact issuer/audience/required dates/subject, verified signed email, no request-email account linking.",
      "commit": "d6573b0401491ad350460d1054bdba414e53f873",
      "after": "Local cryptographic and HTTP positive/negative cases pass."
    },
    {
      "problem": "An already-open WebSocket continued processing events after persisted session revocation/expiry.",
      "before": "Preserved TCP revocation/expiry diagnostic in local-campaign report.",
      "change": "Recheck authentication before each frame and during idle periods, close policy1008 on rejection.",
      "commit": "d6573b0401491ad350460d1054bdba414e53f873",
      "after": "Nine invalidated-session/frame combinations and three idle rechecks pass."
    },
    {
      "problem": "Essential access-token fields were not explicitly required; malformed session IDs could escape controlled rejection.",
      "before": "Review of previous authenticated_user implementation; no claim of a separate pre-fix runtime experiment for every missing field.",
      "change": "Require issuer, subject, session ID, type, issued-at and expiry; reject malformed IDs.",
      "commit": "d6573b0401491ad350460d1054bdba414e53f873",
