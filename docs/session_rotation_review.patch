+async def rotate_device_session(session, raw, device_id, *, now=None, settings=None):
+    settings = settings or get_settings()
+    now = now or utc_now()
+    digest = hash_refresh_token(raw)
+    row = await session.scalar(select(UserSession).where(or_(
+        UserSession.refresh_token_hash == digest,
+        UserSession.previous_refresh_token_hash == digest,
+    )).with_for_update().execution_options(populate_existing=True))
+    if row is None or row.revoked_at is not None or _aware(row.expires_at) <= now:
+        raise invalid_credentials()
