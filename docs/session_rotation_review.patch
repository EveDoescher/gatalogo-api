+import pytest, pytest_asyncio, jwt
+from datetime import UTC, datetime, timedelta
+from sqlalchemy.ext.asyncio import create_async_engine, async_sessionmaker
+from fastapi import HTTPException
+from app.persistence_models import User, UserSession
+from app.config import Settings
+from app.services.auth_service import issue_tokens, rotate_device_session
+
+@pytest_asyncio.fixture
+async def account():
+    engine=create_async_engine('sqlite+aiosqlite:///:memory:')
+    async with engine.begin() as connection:
+        for model in (User,UserSession): await connection.run_sync(model.__table__.create)
+    async with async_sessionmaker(engine,expire_on_commit=False)() as db:
+        user=User(email='rotation@test.invalid',status='active');db.add(user);await db.flush()
+        settings=Settings(jwt_secret='test-secret-'*8)
+        initial=await issue_tokens(db,user=user,device_id='device-a',settings=settings)
+        await db.commit()
+        yield db,settings,initial
+    await engine.dispose()
+
+@pytest.mark.asyncio
+async def test_lost_response_retry_preserves_session_and_token(account):
+    db,settings,initial=account
+    now=datetime.now(UTC)
+    first=await rotate_device_session(db,initial['refresh_token'],'device-a',now=now,settings=settings)
+    await db.commit()
+    retry=await rotate_device_session(db,initial['refresh_token'],'device-a',now=now+timedelta(seconds=10),settings=settings)
+    assert retry['refresh_token']==first['refresh_token']!=initial['refresh_token']
+    claims=lambda token:jwt.decode(token,settings.jwt_secret,algorithms=['HS256'],issuer=settings.jwt_issuer)
+    assert claims(initial['access_token'])['sid']==claims(first['access_token'])['sid']
+    with pytest.raises(HTTPException): await rotate_device_session(db,initial['refresh_token'],'device-a',now=now+timedelta(seconds=61),settings=settings)
+
+@pytest.mark.asyncio
+async def test_device_mismatch_and_logout_are_rejected(account):
+    db,settings,initial=account
+    with pytest.raises(HTTPException): await rotate_device_session(db,initial['refresh_token'],'different-device',settings=settings)
+    row=await db.scalar(__import__('sqlalchemy').select(UserSession))
+    row.revoked_at=datetime.now(UTC);await db.commit()
+    with pytest.raises(HTTPException): await rotate_device_session(db,initial['refresh_token'],'device-a',settings=settings)
